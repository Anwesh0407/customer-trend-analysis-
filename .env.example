# Amazon Vendor Assist (AVA) - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
AVA_DATA_MODE=demo

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# Database Configuration (SQLite by default, PostgreSQL for stage 2)
# SQLite fallback default: sqlite:///./ava.db
DATABASE_URL=sqlite:///./ava.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/amazon_vendor_assist

# AI Assistant (Ask AVA)
# Set to 'demo' for deterministic offline verification, or 'gemini' for live LLM
ASK_AVA_MODE=demo
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Amazon Creator / Influencer API (Optional / Staged)
AMAZON_CREATORS_API_KEY=
AMAZON_CREATORS_API_SECRET=

# Data Collection / Scraper Settings & Compliance
RATE_LIMIT_DELAY_SECONDS=2.0
USER_AGENT="AmazonVendorAssistBot/1.0"
BLOCKED_DOMAINS="amazon.in,amazon.com,media-amazon.com,amazon.co.uk"

