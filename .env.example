# Amazon Vendor Assist (AVA) - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# When PostgreSQL is not available, the backend automatically falls back to SQLite / CSV sample mode.
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amazon_vendor_assist
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Legacy Analysis Database (Reference only)
LEGACY_DB_NAME=customer_behavior

# AI Assistant (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Data Collection / Scraper Settings
RATE_LIMIT_DELAY_SECONDS=2.0
USER_AGENT="AmazonVendorAssistBot/1.0"
